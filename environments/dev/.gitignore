# ==============================================================================
# AIONOS TERRAFORM DEV ENVIRONMENT - .GITIGNORE
# ==============================================================================

# Local provider binaries and module cache
.terraform/
.terraform.rc

# Local state files (Remote backend in Azure Storage is used)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfstate.lock.info

# Generated execution plans
*.tfplan
*.tfplan.bin
*.plan
spoke.apply.tfplan
tfplan-meta.env

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI crash logs
crash.log
crash.*.log

# Explicitly KEEP dependency lock file for provider version locking!
!.terraform.lock.hcl

# Sensitive variable files & keys
*.auto.tfvars
*.secrets.tfvars
secrets.tfvars
local.tfvars
*.pem
*.key
*.id_rsa
id_rsa

# Tool Reports
.tflint.d/
tflint-*.xml
tfsec-*.xml
checkov-*.xml
infracost-*.json

# OS & Editor Junk
Thumbs.db
.DS_Store
.vscode/
.idea/


